<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/floating_ripple">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="135"
                android:startColor="@color/floating_start"
                android:centerColor="@color/floating_middle"
                android:endColor="@color/floating_end" />
            <stroke android:width="1.5dp" android:color="@color/floating_stroke" />
        </shape>
    </item>
</ripple>
