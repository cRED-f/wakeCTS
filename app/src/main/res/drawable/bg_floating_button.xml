<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FF4285F4"
                android:centerColor="#FF9C27B0"
                android:endColor="#FFEA4335"
                android:type="linear" />

            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

</ripple>
